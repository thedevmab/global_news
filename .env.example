# Application
NODE_ENV=development
AUTH_URL=http://localhost:3000
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (Neon: use pooled URL for DATABASE_URL, direct for DIRECT_URL)
# Local Docker Compose (port 5435). For Neon, use pooled URL + direct URL.
DATABASE_URL=postgresql://gvn:gvn_dev_password@localhost:5435/gvn?schema=public
DIRECT_URL=postgresql://gvn:gvn_dev_password@localhost:5435/gvn?schema=public
TEST_DATABASE_URL=postgresql://gvn:gvn_dev_password@localhost:5435/gvn_test?schema=public

# Initial Super Admin (used only by npm run setup:admin)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMeImmediately1
INITIAL_ADMIN_NAME=GVN Super Admin

# Email / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Global Voice Network <noreply@example.com>"
CONTACT_FORWARD_EMAIL=contact@example.com
NEWSLETTER_SENDING_ENABLED=false
NEWSLETTER_CONFIRMATION_REQUIRED=true

# Uploads
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE=/media
# local = disk (dev). db = Postgres (default on Vercel, no Blob needed). s3 = stub.
STORAGE_DRIVER=local
# S3-compatible (optional)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CAPTCHA (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics / SEO
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# Cron
CRON_SECRET=generate-another-long-random-string

# Optional monitoring
SENTRY_DSN=
